<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/pretendard_semibold"
        android:letterSpacing="0.06"
        android:text="@string/booking_main_step_health"
        android:textColor="@color/figma_mvp_primary"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/figma_mvp_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:text="@string/booking_health_section"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="3dp"
                android:text="@string/booking_health_helper"
                android:textColor="@color/figma_mvp_text_tertiary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_figma_booking_health_summary"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textBookingHealthProfileSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_medium"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/booking_health_profile_main_summary_empty"
                    android:textColor="@color/figma_mvp_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textBookingHealthProfileError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="@string/booking_health_profile_main_error"
                    android:textColor="@color/bodeul_error"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBookingHealthProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/booking_health_profile_main_action"
                android:textAllCaps="false"
                android:textColor="@color/figma_mvp_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/figma_mvp_surface"
                app:cornerRadius="24dp"
                app:strokeColor="@color/figma_mvp_divider"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutBookingHealthSummary"
            style="@style/BodeulFigmaFilledInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/booking_health_summary_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputBookingHealthSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutBookingMedicationSummary"
            style="@style/BodeulFigmaFilledInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/booking_medication_summary_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputBookingMedicationSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingMobilityIndependent"
            style="@style/BodeulOutlinedButton"
            android:text="@string/booking_mobility_independent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingMobilityWalkingAid"
            style="@style/BodeulOutlinedButton"
            android:text="@string/booking_mobility_walking_aid" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingMobilityWheelchair"
            style="@style/BodeulOutlinedButton"
            android:text="@string/booking_mobility_wheelchair" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/pretendard_semibold"
        android:letterSpacing="0.06"
        android:text="@string/booking_main_step_participant"
        android:textColor="@color/figma_mvp_primary"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/figma_mvp_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textBookingLinkedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:text="@string/booking_linked_section_default"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textBookingLinkedHelper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="3dp"
                android:text="@string/booking_linked_helper_default"
                android:textColor="@color/figma_mvp_text_tertiary"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBookingLinkedName"
                style="@style/BodeulFigmaFilledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/booking_linked_name_hint_default">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputBookingLinkedName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_medium"
                    android:inputType="textPersonName"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBookingLinkedPhone"
                style="@style/BodeulFigmaFilledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/booking_linked_phone_hint_default">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputBookingLinkedPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_medium"
                    android:inputType="phone"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBookingLinkedEmail"
                style="@style/BodeulFigmaFilledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/booking_linked_email_hint_default">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputBookingLinkedEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_medium"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
