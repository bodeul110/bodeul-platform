<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_reception_title" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_reception_helper" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_final_guide_input"
            android:padding="15dp">
            <TextView
                style="@style/FinalGuideLabel"
                android:text="@string/guide_reception_queue_label"
                android:textSize="13sp"
                android:textColor="@color/final_text_secondary" />
            <EditText
                android:id="@+id/inputGuideReceptionQueue"
                android:importantForAutofill="no"
                style="@style/FinalGuideInput"
                android:background="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textSize="20sp"
                android:fontFamily="@font/pretendard_bold"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="20"
                android:hint="@string/guide_reception_queue_hint" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical"
            android:background="@drawable/bg_final_guide_input"
            android:padding="15dp">
            <TextView
                style="@style/FinalGuideLabel"
                android:text="@string/guide_reception_wait_label"
                android:textSize="13sp"
                android:textColor="@color/final_text_secondary" />
            <EditText
                android:id="@+id/inputGuideReceptionWaitMinutes"
                android:importantForAutofill="no"
                style="@style/FinalGuideInput"
                android:background="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textSize="20sp"
                android:fontFamily="@font/pretendard_bold"
                android:inputType="number"
                android:maxLength="3"
                android:hint="@string/guide_reception_wait_hint" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textGuideReceptionPatient"
            style="@style/FinalGuideLabel" />
        <TextView
            android:id="@+id/textGuideReceptionHospital"
            style="@style/FinalGuideHelper"
            android:gravity="start" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonGuideReceptionShare"
        style="@style/BodeulFinalPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/final_guide_reception_send" />
    <TextView
        android:id="@+id/textGuideReceptionLastShare"
        style="@style/FinalGuideHelper" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuideReceptionFieldNote"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_reception_field_note_open" />
</LinearLayout>