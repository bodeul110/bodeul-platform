<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSubmitBooking"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/pretendard_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/booking_submit_button"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="17sp"
        app:backgroundTint="@color/figma_mvp_primary"
        app:cornerRadius="34dp"
        app:icon="@drawable/ic_figma_guide_arrow_vector"
        app:iconGravity="textEnd"
        app:iconPadding="12dp"
        app:iconTint="@color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/pretendard_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/booking_main_submit_helper"
        android:textColor="@color/figma_mvp_text_tertiary"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCancelBookingEdit"
        style="@style/BodeulOutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/booking_cancel_edit_button"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBooking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        app:indicatorColor="@color/figma_mvp_primary" />
</merge>
