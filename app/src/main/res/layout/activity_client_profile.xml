<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/final_surface">
    <LinearLayout
        android:id="@+id/profileTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_final_profile_segments">
            <TextView
                android:id="@+id/buttonProfileGeneral"
                style="@style/FinalProfileSegment"
                android:text="@string/final_profile_general" />
            <TextView
                android:id="@+id/buttonProfileManager"
                style="@style/FinalProfileSegment"
                android:text="@string/final_profile_manager" />
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_final_profile_toolbar"
            android:elevation="3dp">
            <ImageButton
                android:id="@+id/buttonProfileSettings"
                style="@style/FinalProfileIconButton"
                android:src="@drawable/bodeul_final_profile_settings"
                android:contentDescription="@string/final_profile_settings" />
            <ImageButton
                android:id="@+id/buttonProfileNotifications"
                style="@style/FinalProfileIconButton"
                android:src="@drawable/bodeul_final_profile_alarm"
                android:contentDescription="@string/final_profile_notifications" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/scrollClientProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="15dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <include
                    android:id="@+id/clientProfileStatePanel"
                    layout="@layout/include_state_panel" />
                <LinearLayout
                    android:id="@+id/clientProfileContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:clipChildren="false">
                    <LinearLayout
                        android:id="@+id/profileIdentityCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:padding="15dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_final_profile_brand">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="13dp"
                            android:src="@drawable/bodeul_final_profile_avatar"
                            android:background="@drawable/bg_final_profile_avatar"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp">
                            <TextView
                                android:id="@+id/textClientProfileName"
                                style="@style/FinalProfileName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:id="@+id/textClientProfileEmail"
                                style="@style/FinalHomeCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/final_text_on_primary" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/buttonProfileEdit"
                            style="@style/BodeulFinalLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:drawableStart="@drawable/bodeul_final_profile_edit"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/final_text_on_primary"
                            android:text="@string/final_profile_edit"
                            android:textSize="12sp"
                            android:textColor="@color/final_text_on_primary"
                            android:background="@drawable/bg_final_profile_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                        <ImageButton
                            android:id="@+id/buttonProfileView"
                            style="@style/FinalProfileIconButton"
                            android:src="@drawable/bodeul_final_profile_view"
                            app:tint="@color/final_text_on_primary"
                            android:background="@drawable/bg_final_profile_pill"
                            android:contentDescription="@string/final_profile_view"
                            android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="74dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_final_profile_banner"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <TextView
                            style="@style/FinalHomeValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/final_profile_banner"
                            android:textColor="@color/white" />
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="2dp"
                            android:src="@drawable/bodeul_final_profile_banner"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/profileManagerSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:clipChildren="false">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="91dp"
                            android:layout_marginTop="10dp"
                            android:padding="15dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_final_profile_earnings">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/FinalHomeCaption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/final_profile_earnings"
                                    android:textColor="@color/final_text_primary"
                                    android:textSize="13sp" />
                                <TextView
                                    style="@style/FinalHomeTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/final_profile_earnings_unavailable" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/buttonProfileWithdraw"
                                style="@style/BodeulFinalLink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_final_profile_pill"
                                android:text="@string/final_profile_withdraw"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/profileManagerShortcuts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_final_profile_surface"
                            android:elevation="3dp"
                            android:paddingStart="15dp"
                            android:paddingEnd="15dp"
                            android:paddingTop="18dp"
                            android:paddingBottom="18dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/profileMenuContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_final_profile_surface"
                        android:elevation="3dp"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ProgressBar
            android:id="@+id/progressClientProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
    <include
        layout="@layout/include_client_bottom_navigation" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/profileManagerBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/final_surface"
        android:visibility="gone"
        app:itemIconSize="30dp"
        app:itemHorizontalTranslationEnabled="false"
        app:itemTextAppearanceActive="@style/FinalHomeNavText"
        app:itemTextAppearanceInactive="@style/FinalHomeNavText"
        app:itemIconTint="@color/client_bottom_navigation_item"
        app:itemTextColor="@color/client_bottom_navigation_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_manager_final_navigation"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>