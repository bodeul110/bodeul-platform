<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/guide_summary_title" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/guide_summary_body" />
    <TextView
        android:id="@+id/textGuideSummaryStep"
        style="@style/FinalGuideHelper"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textGuideSummaryPatient"
            style="@style/FinalGuideLabel" />
        <TextView
            android:id="@+id/textGuideSummaryHospital"
            style="@style/FinalGuideHelper"
            android:gravity="start" />
        <TextView
            android:id="@+id/textGuideSummaryDepartment"
            style="@style/FinalGuideHelper"
            android:gravity="start" />
    </LinearLayout>
    <TextView
        style="@style/FinalGuideSection"
        android:text="@string/final_guide_consultation_note" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:counterEnabled="true"
        app:counterMaxLength="2000"
        app:counterTextColor="@color/final_text_secondary"
        app:boxBackgroundMode="none">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGuideSummaryNote"
            android:saveEnabled="false"
            style="@style/FinalGuideTextArea"
            android:hint="@string/guide_summary_note_hint"
            android:maxLength="2000" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuideSummarySaveNote"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_summary_save_note" />
</LinearLayout>