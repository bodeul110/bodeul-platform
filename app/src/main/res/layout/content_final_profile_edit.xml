<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout android:id="@+id/batchEditPhoto" android:layout_width="100dp" android:layout_height="100dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="22dp"
        android:background="@drawable/bg_batch_profile_circle"
        android:clickable="true" android:focusable="true" android:contentDescription="@string/batch_edit_photo">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="18dp" android:src="@drawable/bodeul_final_profile_avatar" android:importantForAccessibility="no" />
        <TextView style="@style/FinalSettingsValue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="24dp" android:layout_gravity="bottom" android:gravity="center"
            android:background="@color/final_text_secondary" android:textColor="@android:color/white"
            android:text="@string/batch_edit_short" android:importantForAccessibility="no" />
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/batchEditName" style="@style/FinalHomeTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:gravity="center"
        android:textSize="22sp" app:drawableEndCompat="@drawable/bodeul_final_profile_edit" android:drawablePadding="6dp"
        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" />
    <include android:id="@+id/batchEditAccount" layout="@layout/item_final_profile_menu"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
    <include android:id="@+id/batchEditHealth" layout="@layout/item_final_profile_menu" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/batchEditAction" style="@style/BodeulFinalPrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:layout_marginTop="16dp" android:text="@string/batch_edit_action" />
</merge>
