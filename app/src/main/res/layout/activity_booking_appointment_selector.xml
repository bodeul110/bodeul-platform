<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookingAppointmentSelectorRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/layoutBookingAppointmentTopBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="60dp" android:gravity="center_vertical"
        android:paddingStart="15dp" android:paddingEnd="6dp">
        <TextView style="@style/FinalHospitalTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/final_schedule_title" />
        <ImageButton android:id="@+id/buttonBookingAppointmentBack"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/bodeul_final_hospital_close"
            android:contentDescription="@string/booking_appointment_schedule_back" />
    </LinearLayout>
    <ScrollView android:id="@+id/scrollBookingAppointmentSelector"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center">
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                    <View android:layout_width="26dp" android:layout_height="26dp"
                        android:layout_gravity="center" android:background="@drawable/bg_final_calendar_arrow"
                        android:importantForAccessibility="no" />
                    <ImageButton android:id="@+id/buttonBookingAppointmentPreviousMonth"
                        style="@style/FinalCalendarArrow" android:src="@drawable/ic_final_calendar_previous"
                        android:contentDescription="@string/booking_appointment_schedule_previous_month" />
                </FrameLayout>
                <TextView android:id="@+id/textBookingAppointmentDisplayedMonth" style="@style/FinalHospitalTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="20sp" android:paddingStart="4dp" android:paddingEnd="4dp" />
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                    <View android:layout_width="26dp" android:layout_height="26dp"
                        android:layout_gravity="center" android:background="@drawable/bg_final_calendar_arrow"
                        android:importantForAccessibility="no" />
                    <ImageButton android:id="@+id/buttonBookingAppointmentNextMonth"
                        style="@style/FinalCalendarArrow" android:src="@drawable/ic_final_calendar_next"
                        android:contentDescription="@string/booking_appointment_schedule_next_month" />
                </FrameLayout>
            </LinearLayout>
            <GridLayout android:id="@+id/gridBookingAppointmentCalendar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="15dp" android:layout_marginEnd="15dp"
                android:layout_marginTop="6dp" android:columnCount="7"
                android:alignmentMode="alignBounds" android:useDefaultMargins="false" />
            <View android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="20dp" android:background="@color/final_input_surface" />
            <TextView style="@style/FinalHospitalTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_marginTop="20dp"
                android:text="@string/final_schedule_time_title" />
            <com.google.android.material.button.MaterialButton
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/buttonBookingAppointmentCustomTime" style="@style/FinalBookingSelector"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_marginTop="10dp"
                android:minHeight="50dp" android:textSize="14sp"
                android:text="@string/final_schedule_time_select" app:cornerRadius="10dp" />
            <TextView style="@style/FinalBookingCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_marginTop="10dp"
                android:text="@string/final_schedule_time_hint" android:textColor="@color/final_text_secondary" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/layoutBookingAppointmentBottomAction"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="10dp" android:paddingBottom="15dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonBookingAppointmentComplete"
            style="@style/BodeulFinalPrimaryButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/booking_appointment_schedule_complete" />
    </FrameLayout>
</LinearLayout>
