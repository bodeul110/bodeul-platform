<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookingStatusRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="60dp">
        <ImageButton android:id="@+id/buttonBackBookingStatus" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="start|center_vertical" android:layout_marginStart="6dp" android:padding="9dp"
            android:src="@drawable/bodeul_final_back" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/guide_back" />
    </FrameLayout>
    <ScrollView android:id="@+id/scrollBookingStatus" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ProgressBar android:id="@+id/progressBookingStatus" android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal" android:layout_margin="15dp" android:visibility="gone" />
            <include android:id="@+id/bookingStatusStatePanel" layout="@layout/include_state_panel"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/bookingStatusContentContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="30dp" android:visibility="gone">
                <LinearLayout android:id="@+id/bookingStatusHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/textBookingStatusHeroBadge" style="@style/FinalBookingTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/textBookingStatusReference" style="@style/FinalBookingCaption"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="12dp" android:gravity="end" android:textColor="@color/final_text_secondary" />
                </LinearLayout>
                <LinearLayout android:id="@+id/bookingStatusHospital" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="90dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_marginTop="20dp"
                    android:padding="15dp" android:gravity="center_vertical" android:background="@drawable/bg_final_booking_hospital_summary">
                    <ImageView android:id="@+id/imageBookingStatusHospital" android:layout_width="60dp" android:layout_height="60dp"
                        android:padding="18dp" android:src="@drawable/ic_figma_hospital_search_section" app:tint="@color/final_text_accent_accessible" android:importantForAccessibility="no"
                        android:background="@drawable/bg_final_hospital_thumbnail" />
                    <LinearLayout android:id="@+id/bookingStatusHospitalText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="15dp" android:orientation="vertical">
                        <TextView android:id="@+id/textBookingStatusHeroTitle" style="@style/FinalBookingLabel"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_bold" />
                        <TextView android:id="@+id/textBookingStatusHeroBody" style="@style/FinalBookingCaption"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:textColor="@color/final_text_secondary" />
                    </LinearLayout>
                    <TextView android:id="@+id/buttonBookingStatusMap" style="@style/BodeulFinalLink"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/bg_final_booking_status_map"
                        android:text="@string/final_booking_completion_map" android:textColor="@color/final_text_secondary" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="20dp" android:background="@color/final_input_surface" />
                <LinearLayout android:id="@+id/bookingStatusInformation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:clipChildren="false" android:clipToPadding="false">
                    <LinearLayout android:id="@+id/bookingStatusManager" style="@style/FinalBookingStatusSection" android:visibility="gone">
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusManager"
                            style="@style/FinalBookingStatusAccordion" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="15sp" app:backgroundTint="@color/white" app:strokeColor="@color/final_line" app:strokeWidth="1dp" />
                        <TextView android:id="@+id/textBookingStatusManagerContact" style="@style/FinalBookingReviewBody"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/bookingStatusPatientSection" style="@style/FinalBookingStatusSection">
                        <TextView android:id="@+id/textBookingStatusPatientTitle" style="@style/FinalBookingLabel"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/final_booking_status_patient" />
                        <LinearLayout android:id="@+id/bookingStatusParticipantContainer" style="@style/FinalBookingStatusLines" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/bookingStatusMeetingSection" style="@style/FinalBookingStatusSection">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:id="@+id/textBookingStatusMeetingTitle" style="@style/FinalBookingLabel"
                                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/final_booking_status_meeting" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusEdit"
                                style="@style/FinalBookingChoice" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="10dp" android:minHeight="48dp" android:text="@string/final_booking_status_edit" android:visibility="gone" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/bookingStatusSummaryContainer" style="@style/FinalBookingStatusLines" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/bookingStatusPaymentSection" style="@style/FinalBookingStatusSection">
                        <TextView android:id="@+id/textBookingStatusPaymentTitle" style="@style/FinalBookingLabel"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/final_booking_status_payment" />
                        <LinearLayout android:id="@+id/bookingStatusPaymentContainer" style="@style/FinalBookingStatusLines" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusBankTransferPayment"
                            style="@style/FinalBookingChoice" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="15dp" android:text="@string/booking_status_action_bank_transfer" android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout style="@style/FinalBookingStatusSection">
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusNote"
                            style="@style/FinalBookingStatusAccordion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/final_booking_status_note" />
                        <TextView android:id="@+id/textBookingStatusNote" style="@style/FinalBookingReviewBody"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout style="@style/FinalBookingStatusSection">
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusProgress"
                            style="@style/FinalBookingStatusAccordion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/final_booking_status_progress" />
                        <LinearLayout android:id="@+id/bookingStatusProgressDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:visibility="gone" android:paddingTop="15dp" android:paddingBottom="15dp">
                            <TextView android:id="@+id/textBookingStatusProgressTitle" style="@style/FinalBookingLabel" android:layout_width="match_parent" android:layout_height="wrap_content" />
                            <TextView android:id="@+id/textBookingStatusProgressBody" style="@style/FinalBookingReviewBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                            <LinearLayout android:id="@+id/bookingStatusStageContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:orientation="vertical" />
                            <LinearLayout android:id="@+id/cardBookingStatusGuide" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="15dp">
                                <TextView android:id="@+id/textBookingStatusGuideTitle" style="@style/FinalBookingLabel" android:layout_width="match_parent" android:layout_height="wrap_content" />
                                <TextView android:id="@+id/textBookingStatusGuideBody" style="@style/FinalBookingReviewBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                            </LinearLayout>
                            <LinearLayout android:id="@+id/cardBookingStatusLive" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                                <LinearLayout android:id="@+id/bookingStatusLiveContainer" style="@style/FinalBookingStatusLines" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/cardBookingStatusReport" style="@style/FinalBookingStatusSection" android:visibility="gone">
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusReport"
                            style="@style/FinalBookingStatusAccordion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/final_booking_status_report" />
                        <LinearLayout android:id="@+id/bookingStatusReportContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusGuardianSharingConsent"
                        style="@style/FinalBookingChoice" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="30dp" android:text="@string/guardian_sharing_consent_open" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusPrimary"
                        style="@style/FinalBookingButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonBookingStatusSecondary"
                        style="@style/FinalBookingChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" />
                    <TextView android:id="@+id/textBookingStatusMode" style="@style/FinalBookingCaption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
