<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLoginWindow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/final_surface">

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/final_surface"
        android:clipToPadding="true"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutLoginContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/final_screen_gutter"
            android:paddingEnd="@dimen/final_screen_gutter"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonLoginBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="-9dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/figma_login_back_content_description"
                    android:padding="9dp"
                    app:srcCompat="@drawable/bodeul_final_back" />
            </FrameLayout>

            <ImageView
                android:id="@+id/imageLoginLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/app_name"
                android:paddingStart="5.93dp"
                android:paddingEnd="5.92dp"
                android:paddingTop="10.17dp"
                android:paddingBottom="2.97dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bodeul_final_logo" />

            <TextView
                android:id="@+id/textLoginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="20sp"
                android:textColor="@color/final_text_primary"
                android:visibility="gone" />
            <TextView
                android:id="@+id/textLoginSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.BodeulFinal.Body"
                android:gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/textDemoBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.BodeulFinal.Caption"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/roleChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRoleManager"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_role_manager" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRolePatient"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_role_patient" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRoleGuardian"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_role_guardian" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutName"
                    style="@style/BodeulFinalInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/final_control_gap"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputName"
                        style="@style/BodeulFinalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_name_hint"
                        android:autofillHints="name"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPhone"
                    style="@style/BodeulFinalInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/final_control_gap"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPhone"
                        style="@style/BodeulFinalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_phone_hint"
                        android:autofillHints="phone"
                        android:inputType="phone"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEmail"
                    style="@style/BodeulFinalInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEmail"
                        style="@style/BodeulFinalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/final_login_email_hint"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPassword"
                    style="@style/BodeulFinalInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/final_control_gap">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPassword"
                        style="@style/BodeulFinalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/final_login_password_hint"
                        android:autofillHints="password"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonSubmitAuth"
                    style="@style/BodeulFinalPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/final_section_gap" />
                <ProgressBar
                    android:id="@+id/progressAuth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="@color/final_brand_primary"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textForgotPassword"
                        style="@style/BodeulFinalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/forgot_password" />
                    <TextView
                        android:id="@+id/textSwitchMode"
                        style="@style/BodeulFinalLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_final_secondary_button"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:gravity="center" />
                </LinearLayout>
                <TextView
                    android:id="@+id/textResendVerification"
                    style="@style/BodeulFinalLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/resend_verification_email"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/layoutSocialDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/textSocialLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BodeulFinal.Caption"
                    android:text="@string/final_login_social_label"
                    android:textColor="@color/final_text_secondary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutSocialButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonSocialKakao"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/social_login_kakao_content_description"
                    android:padding="0dp"
                    app:srcCompat="@drawable/bodeul_final_kakao" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonSocialGoogle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/bodeul_final_google_background"
                    android:contentDescription="@string/social_login_google_content_description"
                    android:padding="10dp"
                    app:srcCompat="@drawable/bodeul_final_google_mark" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonSocialApple"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/bodeul_final_apple_background"
                    android:contentDescription="@string/final_login_apple_description"
                    android:padding="10dp"
                    app:srcCompat="@drawable/bodeul_final_apple_mark" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSocialNaver"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="15dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/social_login_naver_short"
                    android:textColor="@color/white"
                    android:contentDescription="@string/social_login_naver_short"
                    android:visibility="gone"
                    app:backgroundTint="@color/figma_mvp_naver"
                    app:cornerRadius="25dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/textAuthMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_final_auth_message"
        android:textAppearance="@style/TextAppearance.BodeulFinal.Caption"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/white"
        android:includeFontPadding="false"
        app:lineHeight="@dimen/final_caption_line_height"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:accessibilityLiveRegion="assertive"
        android:visibility="gone" />
</FrameLayout>
