<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsDetailRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
        android:paddingStart="6dp" android:paddingEnd="15dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/buttonSettingsDetailBack" style="@style/FinalProfileIconButton"
            android:padding="9dp" android:src="@drawable/bodeul_final_back" android:contentDescription="@string/guide_back" />
        <TextView android:id="@+id/settingsDetailTitle" style="@style/FinalHomeTitle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="22sp" />
        <ImageButton android:id="@+id/buttonRoomNotifications" style="@style/FinalProfileIconButton"
            android:visibility="gone" android:padding="12dp" android:src="@drawable/manager_home_icon_bell"
            android:contentDescription="@string/final_profile_notifications" />
    </LinearLayout>
    <ScrollView android:id="@+id/settingsDetailScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="10dp" android:paddingBottom="24dp">
            <ProgressBar android:id="@+id/settingsDetailProgress" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="center_horizontal" android:visibility="gone" />
            <include android:id="@+id/settingsDetailState" layout="@layout/include_state_panel" />
            <LinearLayout android:id="@+id/settingsDetailContent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <ViewStub android:id="@+id/roomsBottomStub" android:layout="@layout/include_client_bottom_navigation"
        android:layout_width="match_parent" android:layout_height="64dp" />
</LinearLayout>
