<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="24dp" android:background="@color/final_surface">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="30dp"
        android:background="@drawable/bg_final_report_header">
        <TextView android:id="@+id/textGuardianFinalReportDate" style="@style/FinalReportText"
            android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="12sp" android:gravity="center" />
        <TextView android:id="@+id/textFinalReportTitle" style="@style/FinalReportHeading"
            android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginTop="10dp"
            android:text="@string/final_report_title" android:textSize="25sp" app:lineHeight="32sp" android:gravity="center" />
        <TextView android:id="@+id/textFinalReportPatient" style="@style/FinalReportText"
            android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginTop="5dp"
            android:textSize="13sp" android:gravity="center" android:textColor="@color/final_text_accent_accessible" />

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardGuardianFinalReportVisitSummary"
            style="@style/FinalReportCard" android:layout_marginTop="40dp" app:strokeColor="@color/final_brand_primary">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="15dp">
                <TextView android:id="@+id/textGuardianFinalReportHospital" style="@style/FinalReportHeading" android:textSize="15sp" app:lineHeight="22sp" />
                <TextView android:id="@+id/textGuardianFinalReportDepartment" style="@style/FinalReportLabel" android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/cardGuardianFinalReportCondition"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_marginTop="15dp"
            android:padding="15dp" android:orientation="vertical" android:background="@drawable/bg_final_report_note">
            <TextView style="@style/FinalReportLabel" android:text="@string/guardian_final_report_patient_condition_label" />
            <TextView android:id="@+id/textGuardianFinalReportCondition" style="@style/FinalReportText" android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="5dp" android:background="@color/final_input_surface" />
    <TextView android:id="@+id/textFinalReportNotice" style="@style/FinalReportText"
        android:layout_margin="15dp" android:padding="15dp" android:background="@drawable/bg_final_report_note" android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardFinalReportTreatment" style="@style/FinalReportCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="20dp" android:paddingBottom="20dp">
            <TextView android:id="@+id/textFinalReportTreatmentTitle" style="@style/FinalReportHeading" android:text="@string/guardian_final_report_treatment_title" />
            <LinearLayout android:id="@+id/finalReportSections" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardGuardianFinalReportManager" style="@style/FinalReportCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="20dp" android:paddingBottom="20dp">
            <TextView android:id="@+id/textGuardianFinalReportManagerMessageLabel" style="@style/FinalReportHeading" />
            <TextView style="@style/FinalReportText" android:layout_marginTop="20dp" android:textSize="12sp"
                android:textColor="@color/final_text_accent_accessible" android:text="@string/guardian_final_report_manager_role" />
            <TextView android:id="@+id/textGuardianFinalReportManagerName" style="@style/FinalReportHeading"
                android:layout_marginTop="2dp" android:textSize="16sp" app:lineHeight="22sp" />
            <TextView android:id="@+id/textGuardianFinalReportManagerMessage" style="@style/FinalReportText"
                android:layout_marginTop="20dp" android:padding="15dp" android:background="@drawable/bg_final_report_note" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
