<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/final_surface">
    <View
        android:layout_width="0dp"
        android:layout_height="375dp"
        android:background="@drawable/bg_final_home_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/layoutManagerHomeTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp">
                <ImageView
                    android:id="@+id/imageManagerLogo"
                    android:layout_width="46dp"
                    android:layout_height="45.13dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6.87dp"
                    android:src="@drawable/bodeul_final_home_logo"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/textManagerMode"
                style="@style/FinalHomeCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:layout_marginHorizontal="12dp"
                android:gravity="end" />
            <FrameLayout
                android:id="@+id/buttonManagerSupport"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_final_home_bell"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/final_manager_support">
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="noHideDescendants">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="-2dp"
                        android:src="@drawable/bodeul_final_home_bell_base"
                        android:contentDescription="@null" />
                    <ImageView
                        android:layout_width="10.25dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="9.8dp"
                        android:layout_marginTop="19.4dp"
                        android:src="@drawable/bodeul_final_home_bell_lower"
                        android:contentDescription="@null" />
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="16.75dp"
                        android:layout_marginStart="5.5dp"
                        android:layout_marginTop="4.4dp"
                        android:src="@drawable/bodeul_final_home_bell_upper"
                        android:contentDescription="@null" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollManagerHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutManagerHomeTopBar"
        app:layout_constraintBottom_toTopOf="@id/layoutManagerHomeBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingBottom="30dp">
            <include
                android:id="@+id/managerStatePanel"
                layout="@layout/include_state_panel" />
            <LinearLayout
                android:id="@+id/managerContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="52dp"
                    android:paddingHorizontal="5dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">
                        <TextView
                            android:id="@+id/textManagerGreeting"
                            style="@style/FinalHomeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="22sp"
                            app:lineHeight="28sp" />
                        <ImageView
                            android:id="@+id/buttonManagerProfile"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="15dp"
                            android:background="@drawable/bg_final_home_more"
                            android:padding="10dp"
                            android:src="@drawable/bodeul_final_home_nav_profile"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/final_manager_profile" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/textManagerSubtitle"
                        style="@style/FinalHomeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/final_manager_subtitle"
                        android:textSize="15sp"
                        android:textColor="@color/final_text_accent_accessible"
                        android:fontFamily="@font/pretendard_medium" />
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardManagerMatching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:cardBackgroundColor="@color/final_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/final_brand_primary"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingHorizontal="15dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_final_manager_matching_header">
                            <TextView
                                style="@style/FinalHomeTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/final_manager_matching_status"
                                android:textSize="15sp"
                                app:lineHeight="22sp" />
                            <TextView
                                android:id="@+id/buttonManagerMatchingHistory"
                                style="@style/BodeulFinalLink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:text="@string/final_manager_matching_history"
                                android:textSize="13sp"
                                android:textColor="@color/final_text_on_primary" />
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:rotation="180"
                                android:src="@drawable/bodeul_final_home_next"
                                app:tint="@color/final_text_on_primary"
                                android:contentDescription="@null" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="15dp"
                            android:paddingVertical="20dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/textManagerOngoingCount"
                                    style="@style/FinalHomeTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/final_manager_unknown_count" />
                                <TextView
                                    style="@style/FinalHomeCaption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/final_manager_ongoing" />
                            </LinearLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="32dp"
                                android:background="@color/final_line" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/textManagerCompletedCount"
                                    style="@style/FinalHomeTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/final_manager_unknown_count" />
                                <TextView
                                    style="@style/FinalHomeCaption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/final_manager_completed" />
                            </LinearLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="32dp"
                                android:background="@color/final_line" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/textManagerCanceledCount"
                                    style="@style/FinalHomeTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/final_manager_unknown_count" />
                                <TextView
                                    style="@style/FinalHomeCaption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/final_manager_canceled" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:id="@+id/textManagerCountState"
                    style="@style/FinalHomeCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/final_manager_count_loading" />
                <TextView
                    android:id="@+id/buttonManagerCountRetry"
                    style="@style/BodeulFinalLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/state_action_retry"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/buttonManagerDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginTop="20dp"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_final_manager_documents"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/textManagerDocuments"
                        style="@style/FinalHomeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/final_manager_docs"
                        android:textSize="14sp"
                        android:textColor="@color/final_surface" />
                    <TextView
                        android:id="@+id/textManagerDocumentDetail"
                        style="@style/FinalHomeCaption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:text="@string/final_manager_docs_detail"
                        android:textSize="13sp"
                        android:gravity="end"
                        android:textColor="@color/final_surface" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="5dp"
                        android:rotation="180"
                        android:src="@drawable/bodeul_final_home_next"
                        app:tint="@color/final_surface"
                        android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutManagerActiveSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        style="@style/FinalHomeCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/final_manager_current_session" />
                    <TextView
                        android:id="@+id/textManagerActiveTitle"
                        style="@style/FinalHomeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" />
                    <TextView
                        android:id="@+id/textManagerActiveBody"
                        style="@style/FinalHomeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonManagerHeroPrimary"
                        style="@style/BodeulFinalPrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/final_surface"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="20dp"
                        android:orientation="vertical">
                        <TextView
                            style="@style/FinalHomeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/final_home_book" />
                        <LinearLayout
                            android:id="@+id/layoutManagerNoticeContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp" />
                        <LinearLayout
                            android:id="@+id/buttonManagerNoticeMore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="25dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:background="@drawable/bg_final_home_more">
                            <TextView
                                style="@style/FinalHomeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:text="@string/final_home_more" />
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="5dp"
                                android:src="@drawable/bodeul_final_home_next"
                                android:rotation="180"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/buttonManagerHistory"
                        style="@style/BodeulFinalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/final_manager_completed_history"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/buttonManagerFooterSupport"
                        style="@style/BodeulFinalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/final_home_support"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/buttonManagerLogout"
                        style="@style/BodeulFinalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/final_home_sign_out"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    style="@style/FinalHomeCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/final_home_copyright" />
            </LinearLayout>
            <include
                android:id="@+id/managerAppointmentsPanel"
                layout="@layout/include_manager_appointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/layoutManagerHomeBottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/final_surface"
        android:elevation="4dp"
        android:paddingVertical="4dp"
        app:itemIconSize="30dp"
        app:itemHorizontalTranslationEnabled="false"
        app:itemTextAppearanceActive="@style/FinalHomeNavText"
        app:itemTextAppearanceInactive="@style/FinalHomeNavText"
        app:itemIconTint="@color/client_bottom_navigation_item"
        app:itemTextColor="@color/client_bottom_navigation_item"
        app:itemRippleColor="@color/bodeul_soft_blue"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_manager_final_navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
