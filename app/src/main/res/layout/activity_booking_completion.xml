<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookingCompletionRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="8dp">
    <LinearLayout android:id="@+id/bookingCompletionSheet"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@drawable/bg_final_department_sheet">
        <FrameLayout android:layout_width="match_parent" android:layout_height="60dp">
            <View android:layout_width="50dp" android:layout_height="5dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp"
                android:background="@drawable/bg_final_booking_sheet_handle" android:importantForAccessibility="no" />
            <ImageButton android:id="@+id/buttonBackBookingCompletion"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="end|center_vertical" android:layout_marginEnd="6dp" android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/bodeul_final_hospital_close" android:contentDescription="@string/final_booking_completion_close" />
        </FrameLayout>
        <ScrollView android:id="@+id/scrollBookingCompletion"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/bookingCompletionContent"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <ImageView android:id="@+id/imageBookingCompletionSuccess"
                    android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="center_horizontal"
                    android:src="@drawable/bodeul_final_completion_check" android:importantForAccessibility="no" />
                <TextView android:id="@+id/textBookingCompletionTitle" style="@style/FinalBookingCompletionTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp" android:layout_marginTop="20dp" />
                <TextView android:id="@+id/textBookingCompletionBody" style="@style/FinalBookingCompletionBody"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp" android:layout_marginTop="6dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp" android:layout_marginTop="30dp" android:padding="15dp"
                    android:gravity="center_vertical" android:background="@drawable/bg_final_booking_hospital_summary">
                    <TextView android:id="@+id/textBookingCompletionHospital" style="@style/FinalBookingLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:id="@+id/buttonBookingCompletionMap" style="@style/BodeulFinalLink"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:paddingHorizontal="10dp"
                        android:text="@string/final_booking_completion_map" android:textColor="@color/final_text_secondary" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="5dp"
                    android:layout_marginTop="20dp" android:background="@color/final_input_surface" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/textBookingCompletionSummaryTitle" style="@style/FinalBookingLabel" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/final_booking_completion_summary" />
                    <TextView android:id="@+id/buttonBookingCompletionDetail" style="@style/BodeulFinalLink"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/final_booking_completion_detail" android:textColor="@color/final_text_secondary"
                        app:drawableEndCompat="@drawable/ic_final_booking_completion_detail" android:drawablePadding="2dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/bookingCompletionSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp" android:layout_marginTop="5dp" android:layout_marginBottom="8dp"
                    android:paddingHorizontal="15dp" android:paddingTop="5dp" android:paddingBottom="20dp" android:orientation="vertical"
                    android:background="@drawable/bg_final_booking_summary" android:elevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
                        <TextView style="@style/FinalBookingReviewLabel" android:layout_width="70dp" android:layout_height="wrap_content" android:text="@string/final_booking_completion_department" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="20dp" android:orientation="vertical">
                            <TextView android:id="@+id/textBookingCompletionDepartment" style="@style/FinalBookingReviewBody" android:layout_width="match_parent" android:layout_height="wrap_content" />

                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
                        <TextView style="@style/FinalBookingReviewLabel" android:layout_width="70dp" android:layout_height="wrap_content" android:text="@string/booking_completion_date_time_label" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="20dp" android:orientation="vertical">
                            <TextView android:id="@+id/textBookingCompletionDate" style="@style/FinalBookingReviewBody" android:layout_width="match_parent" android:layout_height="wrap_content" />
                            <TextView android:id="@+id/textBookingCompletionTime" style="@style/FinalBookingReviewBody" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
                        <TextView style="@style/FinalBookingReviewLabel" android:layout_width="70dp" android:layout_height="wrap_content" android:text="@string/booking_status_line_place" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="20dp" android:orientation="vertical">
                            <TextView android:id="@+id/textBookingCompletionMeetingPlace" style="@style/FinalBookingReviewBody" android:layout_width="match_parent" android:layout_height="wrap_content" />

                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
                        <TextView style="@style/FinalBookingReviewLabel" android:layout_width="70dp" android:layout_height="wrap_content" android:text="@string/booking_completion_note_label" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="20dp" android:orientation="vertical">
                            <TextView android:id="@+id/textBookingCompletionNote" style="@style/FinalBookingReviewBody" android:layout_width="match_parent" android:layout_height="wrap_content" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/textBookingCompletionPaymentTitle" style="@style/FinalBookingLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp" android:layout_marginTop="20dp" android:text="@string/final_booking_completion_payment_label" />
                <TextView android:id="@+id/textBookingCompletionPayment" style="@style/FinalBookingReviewBody"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="30dp" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/textBookingCompletionAmount" style="@style/FinalBookingReviewBody"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="30dp" android:layout_marginTop="4dp" />
                <TextView style="@style/FinalBookingCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp"
                    android:text="@string/final_booking_completion_payment_notice" android:textColor="@color/final_text_secondary" />
            </LinearLayout>
        </ScrollView>
        <FrameLayout android:id="@+id/bookingCompletionBottomAction"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="15dp" android:paddingTop="10dp" android:paddingBottom="15dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonBookingCompletionList"
                style="@style/BodeulFinalPrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/final_booking_completion_confirm" android:contentDescription="@string/final_booking_completion_confirm_description" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
