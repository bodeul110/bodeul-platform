<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_pharmacy_title" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_pharmacy_helper" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textGuidePharmacyHospital"
            style="@style/FinalGuideLabel" />
        <TextView
            android:id="@+id/textGuidePharmacyDepartment"
            style="@style/FinalGuideHelper"
            android:gravity="start" />
    </LinearLayout>
    <TextView
        android:id="@+id/textGuidePharmacyActionHelp"
        style="@style/FinalGuideHelper"
        android:text="@string/guide_pharmacy_location_body"
        android:gravity="start" />
</LinearLayout>