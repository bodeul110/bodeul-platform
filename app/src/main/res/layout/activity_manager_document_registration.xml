<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/managerDocumentRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/final_surface">
    <LinearLayout android:id="@+id/layoutManagerDocumentTopBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical"
        android:paddingStart="6dp" android:paddingEnd="15dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonBackManagerDocument"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter"
            android:src="@drawable/bodeul_final_back" android:contentDescription="@string/guide_back"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentToolbar"
            style="@style/FinalHomeTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="22sp" app:lineHeight="28sp"
            android:text="@string/final_documents_title"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/scrollManagerDocumentRegistration" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:id="@+id/managerDocumentContentContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="15dp"
                android:paddingEnd="15dp" android:paddingTop="20dp" android:paddingBottom="24dp" android:visibility="gone">
                <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentHeading"
                    style="@style/FinalDocumentTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/final_documents_registration_heading"/>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentSubtitle"
                    style="@style/FinalDocumentCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="@string/final_documents_registration_body"/>
                <TextView android:id="@+id/textManagerDocumentMode" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:visibility="gone"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardManagerDocumentSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
                    android:layout_marginTop="30dp" android:layout_marginBottom="10dp"
                    android:clickable="true" android:focusable="true" android:visibility="gone"
                    app:cardBackgroundColor="@color/final_surface" app:cardCornerRadius="15dp" app:cardElevation="3dp"
                    app:strokeColor="@color/final_line" app:strokeWidth="1dp">
                    <LinearLayout android:id="@+id/managerDocumentSummaryRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
                        android:orientation="horizontal" android:padding="15dp" android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentSummaryTitle"
                            style="@style/FinalHomeTitle" android:textSize="15sp" app:lineHeight="22sp"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <LinearLayout android:id="@+id/managerDocumentSummaryStatusRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical|end">
                            <ImageView android:id="@+id/imageManagerDocumentSummaryStatus" android:layout_width="14dp"
                                android:layout_height="14dp" android:layout_marginEnd="2dp" android:importantForAccessibility="no"/>
                            <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentSummaryStatus"
                                style="@style/FinalDocumentCaption" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardManagerDocumentUpload"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp"
                    app:cardBackgroundColor="@color/final_surface" app:cardCornerRadius="15dp" app:cardElevation="3dp"
                    app:strokeColor="@color/final_line" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingStart="15dp" android:paddingEnd="15dp"
                        android:paddingTop="20dp" android:paddingBottom="25dp">
                        <com.google.android.material.textview.MaterialTextView style="@style/FinalHomeTitle" android:textSize="18sp"
                            app:lineHeight="26sp" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/final_documents_upload_title"/>
                        <com.google.android.material.textview.MaterialTextView style="@style/FinalDocumentCaption"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="@string/final_documents_privacy"/>
                        <com.google.android.material.textview.MaterialTextView style="@style/FinalDocumentCaption"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                            android:textColor="@color/final_text_accent_accessible" android:text="@string/final_documents_required"/>
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentPrimaryTitle"
                            style="@style/FinalHomeTitle" android:textSize="15sp" app:lineHeight="22sp"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonManagerDocumentPrimaryUpload"
                            style="@style/FinalDocumentFileButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/final_documents_upload"/>
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentPrimaryFileName"
                            style="@style/FinalDocumentCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:textColor="@color/final_text_primary" android:visibility="gone"/>
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentPrimaryFileMeta"
                            style="@style/FinalDocumentCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:visibility="gone"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonManagerDocumentPrimaryPreview"
                            style="@style/FinalDocumentButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:minHeight="48dp" android:textColor="@color/final_text_primary"
                            app:backgroundTint="@color/final_surface" app:strokeColor="@color/final_line" app:strokeWidth="1dp"
                            android:text="@string/final_documents_preview" android:visibility="gone"/>
                        <com.google.android.material.textview.MaterialTextView style="@style/FinalDocumentCaption"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                            android:text="@string/final_documents_format"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:id="@+id/managerDocumentStatusContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentStatusTitle"
                        style="@style/FinalDocumentCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/final_text_accent_accessible"/>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentStatusBody"
                        style="@style/FinalDocumentCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/cardManagerDocumentReview" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="15dp" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentReviewTitle"
                        style="@style/FinalDocumentCaption" android:textColor="@color/final_text_error"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/textManagerDocumentReviewBody"
                        style="@style/FinalDocumentCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                </LinearLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/buttonManagerDocumentHistory"
                    style="@style/BodeulFinalLink" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:text="@string/final_documents_history"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/managerDocumentStateScroll" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="vertical" android:padding="15dp">
                <include android:id="@+id/managerDocumentStatePanel" layout="@layout/include_state_panel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <ProgressBar android:id="@+id/progressManagerDocumentRegistration" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/layoutManagerDocumentBottomAction" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonManagerDocumentRequest"
            style="@style/FinalDocumentButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" android:text="@string/final_documents_submit"/>
    </LinearLayout>
</LinearLayout>
