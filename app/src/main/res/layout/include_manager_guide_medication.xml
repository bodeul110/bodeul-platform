<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_medication_title" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_medication_helper" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="15dp"
        android:orientation="vertical">
        <TextView
            style="@style/FinalGuideLabel"
            android:text="@string/guide_medication_existing_title" />
        <TextView
            android:id="@+id/textGuideMedicationExistingSummary"
            style="@style/FinalGuideHelper"
            android:text="@string/guide_medication_existing_empty"
            android:gravity="start" />
        <TextView
            android:id="@+id/textGuideMedicationPrescriptionStatus"
            style="@style/FinalGuideHelper"
            android:text="@string/guide_medication_prescription_empty"
            android:gravity="start" />
    </LinearLayout>
    <TextView
        style="@style/FinalGuideSection"
        android:text="@string/guide_medication_receipt_title" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="15dp"
        android:background="@drawable/bg_final_guide_input">
        <TextView
            style="@style/FinalGuideLabel"
            android:text="@string/guide_medication_prescription_row" />
        <TextView
            android:id="@+id/textGuideMedicationPrescriptionState"
            style="@style/FinalGuideHelper"
            android:text="@string/guide_medication_status_pending"
            android:gravity="start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGuideMedicationTogglePrescription"
            style="@style/FinalGuideSecondaryButton"
            android:text="@string/guide_prescription_mark_collected" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="15dp"
        android:background="@drawable/bg_final_guide_input">
        <TextView
            style="@style/FinalGuideLabel"
            android:text="@string/guide_medication_pharmacy_row" />
        <TextView
            android:id="@+id/textGuideMedicationPharmacyState"
            style="@style/FinalGuideHelper"
            android:text="@string/guide_medication_status_pending"
            android:gravity="start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGuideMedicationTogglePharmacy"
            style="@style/FinalGuideSecondaryButton"
            android:text="@string/guide_pharmacy_mark_completed" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="15dp"
        android:background="@drawable/bg_final_guide_input">
        <TextView
            style="@style/FinalGuideLabel"
            android:text="@string/guide_medication_guidance_row" />
        <TextView
            android:id="@+id/textGuideMedicationGuidanceState"
            style="@style/FinalGuideHelper"
            android:text="@string/guide_medication_status_pending"
            android:gravity="start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGuideMedicationToggleGuidance"
            style="@style/FinalGuideSecondaryButton"
            android:text="@string/guide_medication_guidance_mark_completed" />
    </LinearLayout>
    <TextView
        android:id="@+id/textGuideMedicationProgress"
        style="@style/FinalGuideHelper" />
    <ProgressBar
        android:id="@+id/progressGuideMedication"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:progressTint="@color/final_brand_primary" />
    <TextView
        style="@style/FinalGuideSection"
        android:text="@string/guide_medication_pharmacy_note_label" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:counterEnabled="true"
        app:counterMaxLength="2000"
        app:counterTextColor="@color/final_text_secondary"
        app:boxBackgroundMode="none">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGuideMedicationPharmacyNote"
            style="@style/FinalGuideTextArea"
            android:hint="@string/guide_medication_pharmacy_note_label"
            android:maxLength="2000" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuideMedicationSavePharmacyNote"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_pharmacy_save" />
    <TextView
        style="@style/FinalGuideSection"
        android:text="@string/guide_medication_guidance_note_label" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:counterEnabled="true"
        app:counterMaxLength="2000"
        app:counterTextColor="@color/final_text_secondary"
        app:boxBackgroundMode="none">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGuideMedicationGuidanceNote"
            style="@style/FinalGuideTextArea"
            android:hint="@string/guide_medication_guidance_note_label"
            android:maxLength="2000" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuideMedicationSaveGuidanceNote"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_medication_save" />
</LinearLayout>