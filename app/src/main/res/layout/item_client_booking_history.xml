<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/final_surface"
    app:cardCornerRadius="15dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/final_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textBookingRequestStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:includeFontPadding="false"
            android:textColor="@color/final_text_accent_accessible"
            android:textSize="13sp"
            app:lineHeight="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:contentDescription="@string/final_history_hospital_image_description"
                android:scaleType="centerCrop"
                android:src="@drawable/bodeul_final_history_hospital"
                app:shapeAppearanceOverlay="@style/FinalHistoryHospitalImage" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textBookingRequestTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/pretendard_bold"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/final_text_primary"
                    android:textSize="18sp"
                    app:lineHeight="24sp" />

                <TextView
                    android:id="@+id/textBookingRequestLinked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/pretendard_medium"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/final_text_secondary"
                    android:textSize="13sp"
                    app:lineHeight="18sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/final_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/pretendard_bold"
            android:includeFontPadding="false"
            android:text="@string/final_history_appointment_label"
            android:textColor="@color/final_text_secondary"
            android:textSize="12sp"
            app:lineHeight="16sp" />

        <TextView
            android:id="@+id/textBookingRequestDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:textColor="@color/final_text_primary"
            android:textSize="15sp"
            app:lineHeight="21sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/pretendard_bold"
            android:includeFontPadding="false"
            android:text="@string/final_history_meeting_place_label"
            android:textColor="@color/final_text_secondary"
            android:textSize="12sp"
            app:lineHeight="16sp" />

        <TextView
            android:id="@+id/textBookingRequestPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:textColor="@color/final_text_primary"
            android:textSize="15sp"
            app:lineHeight="21sp" />

        <LinearLayout
            android:id="@+id/layoutBookingRequestActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBookingRequestReview"
                style="@style/FinalHistorySecondaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/final_history_review_action" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBookingRequestReport"
                style="@style/FinalHistoryPrimaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/final_history_report_action" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
