<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_payment_title" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_payment_helper" />
    <TextView
        android:id="@+id/textGuidePaymentStep"
        style="@style/FinalGuideHelper"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/buttonGuidePaymentSelect"
        android:contentDescription="@string/guide_payment_upload_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="170dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/bodeul_final_guide_upload"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/textGuidePaymentSelectLabel"
            style="@style/FinalGuideLabel"
            android:text="@string/guide_payment_select_empty"
            android:gravity="center"
            android:layout_marginTop="10dp" />
        <TextView
            style="@style/FinalGuideHelper"
            android:text="@string/guide_payment_select_helper"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/textGuidePaymentStatus"
        style="@style/FinalGuideHelper"
        android:text="@string/guide_payment_status_empty" />
    <TextView
        android:id="@+id/textGuidePaymentFile"
        style="@style/FinalGuideHelper" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuidePaymentClear"
        android:contentDescription="@string/guide_payment_clear_description"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_payment_clear" />
    <TextView
        style="@style/FinalGuideSection"
        android:text="@string/guide_payment_note_title" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:counterEnabled="true"
        app:counterMaxLength="2000"
        app:counterTextColor="@color/final_text_secondary"
        app:boxBackgroundMode="none">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGuidePaymentNote"
            style="@style/FinalGuideTextArea"
            android:hint="@string/guide_payment_note_hint"
            android:maxLength="2000" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuidePaymentSaveNote"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_payment_note_save" />
    <TextView
        style="@style/FinalGuideSection"
        android:text="@string/guide_payment_location_title" />
    <TextView
        android:id="@+id/textGuidePaymentHospital"
        style="@style/FinalGuideLabel" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/guide_payment_location_helper"
        android:gravity="start" />
</LinearLayout>