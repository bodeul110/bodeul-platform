<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textGuidePaymentStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_blue"
        android:fontFamily="@font/pretendard_bold"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/figma_mvp_primary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/pretendard_bold"
        android:text="@string/guide_payment_title"
        android:textColor="@color/figma_mvp_text_primary"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/pretendard_regular"
        android:lineSpacingExtra="3dp"
        android:text="@string/guide_payment_body"
        android:textColor="@color/figma_mvp_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/figma_mvp_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/guide_payment_location_title"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textGuidePaymentHospital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pretendard_semibold"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/figma_mvp_primary"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/figma_payment_counter_map" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="2dp"
                android:text="@string/guide_payment_location_helper"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/figma_mvp_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="@string/guide_payment_evidence_title"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_blue"
                    android:fontFamily="@font/pretendard_semibold"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/guide_payment_evidence_optional"
                    android:textColor="@color/figma_mvp_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonGuidePaymentSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_figma_prescription_upload_area"
                android:clickable="true"
                android:contentDescription="@string/guide_payment_upload_description"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:minHeight="156dp"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_figma_prescription_camera_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_figma_prescription_camera" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textGuidePaymentSelectLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/pretendard_semibold"
                    android:text="@string/guide_payment_select_empty"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:gravity="center"
                    android:text="@string/guide_payment_select_helper"
                    android:textColor="@color/figma_mvp_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textGuidePaymentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/pretendard_semibold"
                android:lineSpacingExtra="2dp"
                android:text="@string/guide_payment_status_empty"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textGuidePaymentFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/pretendard_regular"
                android:maxLines="2"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGuidePaymentClear"
                style="@style/BodeulOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/guide_payment_clear_description"
                android:text="@string/guide_payment_clear"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/figma_mvp_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/guide_payment_note_title"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="2dp"
                android:text="@string/guide_payment_note_helper"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputGuidePaymentNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_figma_vitals_input"
                android:gravity="top|start"
                android:hint="@string/guide_payment_note_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:minHeight="104dp"
                android:padding="16dp"
                android:textColor="@color/figma_mvp_text_primary"
                android:textColorHint="@color/figma_mvp_text_hint"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGuidePaymentSaveNote"
                style="@style/BodeulOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/guide_payment_note_save" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
