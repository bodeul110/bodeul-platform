<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_prescription_title" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_prescription_helper" />
    <TextView
        android:id="@+id/textGuidePrescriptionStep"
        style="@style/FinalGuideHelper"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/buttonGuidePrescriptionSelect"
        android:contentDescription="@string/guide_prescription_upload_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="170dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/bodeul_final_guide_upload"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/textGuidePrescriptionSelectLabel"
            style="@style/FinalGuideLabel"
            android:text="@string/guide_prescription_select_empty"
            android:gravity="center"
            android:layout_marginTop="10dp" />
        <TextView
            style="@style/FinalGuideHelper"
            android:text="@string/guide_prescription_select_helper"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/textGuidePrescriptionStatus"
        style="@style/FinalGuideHelper"
        android:text="@string/guide_prescription_status_empty" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuidePrescriptionClear"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_prescription_clear" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuidePrescriptionFieldNote"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_prescription_field_note_open" />
</LinearLayout>