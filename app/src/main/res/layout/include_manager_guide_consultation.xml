<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guideConsultationContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_group_6" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_consultation_helper" />
    <TextView
        android:id="@+id/textGuideConsultationStep"
        style="@style/FinalGuideHelper"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/progressGuideConsultation"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_manual"
        android:layout_marginTop="30dp"
        android:padding="10dp"
        android:background="@drawable/bg_final_guide_input" />
    <TextView
        android:id="@+id/textGuideConsultationFieldNoteLabel"
        style="@style/FinalGuideSection"
        android:text="@string/final_guide_consultation_note" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:counterEnabled="true"
        app:counterMaxLength="2000"
        app:counterTextColor="@color/final_text_secondary"
        app:boxBackgroundMode="none">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGuideConsultationFieldNote"
            android:saveEnabled="false"
            style="@style/FinalGuideTextArea"
            android:hint="@string/guide_consultation_field_hint"
            android:maxLength="2000" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuideConsultationSaveFieldNote"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_consultation_field_save" />
    <TextView
        android:id="@+id/textGuideConsultationGuardianLabel"
        style="@style/FinalGuideSection"
        android:text="@string/final_guide_guardian_note" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:counterEnabled="true"
        app:counterMaxLength="1000"
        app:counterTextColor="@color/final_text_secondary"
        app:boxBackgroundMode="none">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGuideConsultationGuardian"
            android:saveEnabled="false"
            style="@style/FinalGuideTextArea"
            android:hint="@string/guide_consultation_guardian_hint"
            android:maxLength="1000" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuideConsultationSaveGuardian"
        style="@style/FinalGuideSecondaryButton"
        android:text="@string/guide_consultation_guardian_save" />
    <LinearLayout
        android:id="@+id/layoutGuideConsultationRecordingPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            style="@style/FinalGuideHelper"
            android:text="@string/guide_consultation_record_preview_badge" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/buttonGuideConsultationRecordPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_figma_consultation_microphone"
            android:contentDescription="@string/guide_consultation_record_ready" />
        <Chronometer
            android:id="@+id/chronometerGuideConsultation"
            style="@style/FinalGuideLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/textGuideConsultationRecordStatus"
            style="@style/FinalGuideHelper"
            android:text="@string/guide_consultation_record_ready" />
    </LinearLayout>
</LinearLayout>