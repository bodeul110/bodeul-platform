<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/final_surface">

    <ScrollView
        android:id="@+id/clientBookingHistoryScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/clientBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/clientBookingHistoryScrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/final_screen_gutter"
            android:paddingTop="28dp"
            android:paddingEnd="@dimen/final_screen_gutter"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/textClientBookingHistoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:includeFontPadding="false"
                android:text="@string/final_history_title"
                android:textColor="@color/final_text_primary"
                android:textSize="22sp"
                app:lineHeight="29sp" />

            <LinearLayout
                android:id="@+id/clientCalendarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <CalendarView
                    android:id="@+id/clientCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/textClientCalendarDate"
                    style="@style/FinalHomeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    style="@style/FinalHomeCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/final_calendar_undated" />

                <TextView
                    android:id="@+id/textClientCalendarEmpty"
                    style="@style/FinalHomeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="16dp"
                    android:text="@string/final_calendar_empty"
                    android:visibility="gone" />
            </LinearLayout>

            <include
                android:id="@+id/clientBookingHistoryStatePanel"
                layout="@layout/include_state_panel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOpenGuardianBookingInbox"
                style="@style/BodeulOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/guardian_booking_inbox_title"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/clientBookingHistoryContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layoutClientBookingHistoryFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_final_history_filter_bar"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/buttonHistoryFilterMatching"
                        style="@style/FinalHistoryFilterTab"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/final_history_filter_matching" />

                    <TextView
                        android:id="@+id/buttonHistoryFilterProgress"
                        style="@style/FinalHistoryFilterTab"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/final_history_filter_progress" />

                    <TextView
                        android:id="@+id/buttonHistoryFilterCompleted"
                        style="@style/FinalHistoryFilterTab"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/final_history_filter_completed" />

                    <TextView
                        android:id="@+id/buttonHistoryFilterCanceled"
                        style="@style/FinalHistoryFilterTab"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/final_history_filter_canceled" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textClientBookingHistoryFilterEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="@font/pretendard_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingVertical="32dp"
                    android:textColor="@color/final_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:lineHeight="20sp" />

                <LinearLayout
                    android:id="@+id/layoutClientBookingHistoryEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressClientBookingHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/clientBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/clientBottomNavigation"
        layout="@layout/include_client_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
