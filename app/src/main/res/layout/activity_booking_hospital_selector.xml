<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookingHospitalSelectorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/final_surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="6dp">
        <TextView
            style="@style/FinalHospitalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/final_hospital_title" />
        <ImageButton
            android:id="@+id/buttonBookingHospitalOptions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_figma_more_vertical"
            android:contentDescription="@string/final_hospital_options" />
        <ImageButton
            android:id="@+id/buttonBackBookingHospitalSelector"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/bodeul_final_hospital_close"
            android:contentDescription="@string/final_hospital_close" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:background="@drawable/bg_final_hospital_search"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="3dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/bodeul_final_hospital_search"
            android:importantForAccessibility="no" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/searchBookingHospital"
            style="@style/BodeulFinalInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:paddingStart="5dp"
            android:paddingEnd="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:hint="@string/booking_hospital_selector_search_hint" />
        <ImageButton
            android:id="@+id/buttonClearBookingHospital"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/bodeul_final_hospital_clear"
            android:contentDescription="@string/final_hospital_clear" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bookingHospitalSelectorContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ListView
            android:id="@+id/listBookingHospitalOptions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="20dp"
            android:listSelector="@android:color/transparent"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:scrollbars="none" />
        <ScrollView
            android:id="@+id/bookingHospitalEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="30dp"
                android:paddingBottom="20dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/bodeul_final_hospital_empty"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/textBookingHospitalEmpty"
                    style="@style/FinalBookingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:fontFamily="@font/pretendard_semibold"
                    android:text="@string/final_hospital_empty" />
                <TextView
                    style="@style/FinalBookingCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/final_hospital_empty_body"
                    android:textColor="@color/final_text_secondary" />
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/bookingHospitalError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <include
                android:id="@+id/bookingHospitalSelectorStatePanel"
                layout="@layout/include_state_panel" />
        </ScrollView>
        <ProgressBar
            android:id="@+id/progressBookingHospitalSelector"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/final_text_accent_accessible" />
    </FrameLayout>
    <TextView
        android:id="@+id/buttonBookingHospitalManualInput"
        style="@style/BodeulFinalLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/booking_hospital_selector_manual_short_button"
        android:textColor="@color/final_text_accent_accessible" />
</LinearLayout>