<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_journal" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_final_helper" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textGuideJournalStatusTitle"
            style="@style/FinalGuideLabel" />
        <TextView
            android:id="@+id/textGuideJournalPatient"
            style="@style/FinalGuideHelper" />
        <TextView
            android:id="@+id/textGuideJournalStatusBody"
            style="@style/FinalGuideHelper" />
    </LinearLayout>
</LinearLayout>