<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_vitals_title" />
    <TextView
        android:id="@+id/textGuideVitalsHelper"
        style="@style/FinalGuideHelper"
        android:text="@string/guide_vitals_helper_unknown" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_measurement"
        android:padding="15dp"
        android:elevation="3dp"
        android:orientation="vertical">
        <TextView
            style="@style/FinalGuideLabel"
            android:text="@string/guide_vitals_blood_pressure"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold" />
        <TextView
            style="@style/FinalGuideHelper"
            android:text="@string/guide_vitals_blood_pressure_caption"
            android:gravity="start"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/FinalGuideLabel"
                    android:text="@string/guide_vitals_systolic"
                    android:layout_marginBottom="10dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputGuideVitalsSystolic"
                    style="@style/FinalGuideInput"
                    android:textSize="20sp"
                    android:hint="@string/guide_vitals_systolic_hint"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="15dp"
                android:orientation="vertical">
                <TextView
                    style="@style/FinalGuideLabel"
                    android:text="@string/guide_vitals_diastolic"
                    android:layout_marginBottom="10dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputGuideVitalsDiastolic"
                    style="@style/FinalGuideInput"
                    android:textSize="20sp"
                    android:hint="@string/guide_vitals_diastolic_hint"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_measurement"
        android:padding="15dp"
        android:elevation="3dp"
        android:orientation="vertical">
        <TextView
            style="@style/FinalGuideLabel"
            android:text="@string/guide_vitals_heart_rate"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputGuideVitalsHeartRate"
                    style="@style/FinalGuideInput"
                    android:textSize="20sp"
                    android:hint="@string/guide_vitals_heart_rate_hint"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>
            <TextView
                style="@style/FinalGuideLabel"
                android:layout_width="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/guide_vitals_heart_rate_unit" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_measurement"
        android:padding="15dp"
        android:elevation="3dp"
        android:orientation="vertical">
        <TextView
            style="@style/FinalGuideLabel"
            android:text="@string/guide_vitals_weight"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputGuideVitalsWeight"
                    style="@style/FinalGuideInput"
                    android:textSize="20sp"
                    android:hint="@string/guide_vitals_weight_hint"
                    android:inputType="numberDecimal"
                    android:maxLength="5"
                    android:digits="0123456789." />
            </LinearLayout>
            <TextView
                style="@style/FinalGuideLabel"
                android:layout_width="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/guide_vitals_weight_unit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>