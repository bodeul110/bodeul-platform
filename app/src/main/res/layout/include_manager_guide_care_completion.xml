<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_green"
        android:fontFamily="@font/pretendard_bold"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/guide_completion_step_badge"
        android:textColor="@color/bodeul_success"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/pretendard_bold"
        android:text="@string/guide_completion_step"
        android:textColor="@color/figma_mvp_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/pretendard_bold"
        android:lineSpacingExtra="2dp"
        android:text="@string/guide_completion_title"
        android:textColor="@color/figma_mvp_text_primary"
        android:textSize="28sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/pretendard_regular"
        android:lineSpacingExtra="4dp"
        android:text="@string/guide_completion_body"
        android:textColor="@color/figma_mvp_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/figma_mvp_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_figma_guide_hero_icon">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_figma_guide_patient_vector" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="@string/guide_completion_patient_title"
                    android:textColor="@color/figma_mvp_text_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textGuideCompletionPatient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pretendard_bold"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/textGuideCompletionHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:textColor="@color/figma_mvp_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/figma_mvp_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/guide_completion_memo_title"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard_regular"
                android:text="@string/guide_completion_memo_body"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/guideCompletionMemoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textGuideCompletionMemoEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/pretendard_regular"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/guide_completion_memo_empty"
                android:textColor="@color/figma_mvp_text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_figma_booking_schedule_info_box"
        android:drawablePadding="10dp"
        android:fontFamily="@font/pretendard_medium"
        android:lineSpacingExtra="3dp"
        android:padding="16dp"
        android:text="@string/guide_completion_warning"
        android:textColor="@color/figma_mvp_gold_text"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_figma_booking_schedule_info" />
</LinearLayout>
