<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/FinalGuideHeading"
        android:text="@string/final_guide_return_title" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/final_guide_return_helper" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_final_guide_outline"
        android:padding="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textGuideCompletionPatient"
            style="@style/FinalGuideLabel" />
        <TextView
            android:id="@+id/textGuideCompletionHospital"
            style="@style/FinalGuideHelper"
            android:gravity="start" />
    </LinearLayout>
    <TextView
        style="@style/FinalGuideSection"
        android:text="@string/guide_completion_memo_title" />
    <LinearLayout
        android:id="@+id/guideCompletionMemoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView
        android:id="@+id/textGuideCompletionMemoEmpty"
        style="@style/FinalGuideHelper"
        android:text="@string/guide_completion_memo_empty" />
    <TextView
        style="@style/FinalGuideHelper"
        android:text="@string/guide_completion_warning" />
</LinearLayout>