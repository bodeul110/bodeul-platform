<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView style="@style/FinalSettingsLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/final_settings_email" />
    <LinearLayout android:id="@+id/accountEmailCard" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="50dp" android:layout_marginTop="10dp" android:padding="15dp"
        android:background="@drawable/bg_final_settings_email" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/accountProviderIcon" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginEnd="15dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/accountProviderName" style="@style/FinalSettingsValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/accountSettingsEmail" style="@style/FinalSettingsValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:saveEnabled="false" />
        </LinearLayout>
        <TextView android:id="@+id/accountProviderState" style="@style/FinalSettingsLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:maxWidth="90dp" app:drawableStartCompat="@drawable/bodeul_final_booking_check" android:drawablePadding="5dp"
            android:textColor="@color/final_text_accent_accessible" android:text="@string/final_settings_link_complete" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/accountPasswordSection" style="@style/FinalSettingsSection" android:visibility="gone">
        <TextView style="@style/FinalSettingsLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/final_settings_password" />
        <TextView android:id="@+id/buttonAccountPassword" style="@style/FinalSettingsAction" android:layout_marginTop="10dp"
            android:minHeight="50dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="14sp"
            android:background="@drawable/bg_final_settings_group" app:drawableEndCompat="@drawable/final_settings_arrow_next_black"
            android:text="@string/final_settings_password_change" />
    </LinearLayout>
    <LinearLayout style="@style/FinalSettingsSection">
        <TextView style="@style/FinalSettingsLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/final_settings_optional_terms" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:orientation="vertical" android:background="@drawable/bg_final_settings_group">
            <TextView android:id="@+id/buttonAccountPrivacyConsent" style="@style/FinalSettingsAction" android:text="@string/final_settings_privacy_consent" />
            <TextView android:id="@+id/buttonAccountMarketingConsent" style="@style/FinalSettingsAction" android:layout_marginTop="2dp"
                android:text="@string/final_settings_marketing_consent" />
            <TextView style="@style/FinalSettingsLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/final_text_secondary" android:text="@string/final_settings_consent_unknown" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/accountLinkSection" style="@style/FinalSettingsSection" android:visibility="gone">
        <TextView style="@style/FinalSettingsLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/final_settings_link_heading" />
        <LinearLayout android:id="@+id/accountProviderRows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:padding="15dp" android:orientation="vertical" android:background="@drawable/bg_final_settings_group" />
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_marginTop="30dp" android:layout_weight="1" />
    <TextView android:id="@+id/buttonAccountWithdraw" style="@style/BodeulFinalLink"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp"
        android:background="@drawable/bg_final_profile_pill" android:text="@string/final_settings_withdraw" />
</LinearLayout>
