<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:minHeight="60dp">
    <ImageView
        android:id="@+id/imageBookingHospitalOption"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="18dp"
        android:background="@drawable/bg_final_hospital_thumbnail"
        android:src="@drawable/ic_map_marker_hospital"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/buttonBookingHospitalOption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true">
        <TextView
            android:id="@+id/textBookingHospitalOptionName"
            style="@style/FinalBookingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/textBookingHospitalOptionDepartments"
            style="@style/FinalBookingCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/final_text_secondary" />
    </LinearLayout>
    <TextView
        android:id="@+id/buttonBookingHospitalMap"
        style="@style/BodeulFinalLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="48dp"
        android:background="@drawable/bg_final_hospital_map"
        app:drawableStartCompat="@drawable/bodeul_final_hospital_map"
        android:drawablePadding="5dp"
        android:text="@string/final_hospital_map"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />
</LinearLayout>