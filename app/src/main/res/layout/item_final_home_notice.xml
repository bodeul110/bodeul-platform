<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="70dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageNoticeBanner"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null"
        app:shapeAppearanceOverlay="@style/FinalHomeNoticeImage" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textNoticeTitle"
            style="@style/FinalHomeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/final_text_primary" />
        <TextView
            android:id="@+id/textNoticeEyebrow"
            style="@style/FinalHomeCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>