<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/final_surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:paddingStart="6dp"
        android:paddingEnd="15dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/buttonProfileSettingsBack"
            style="@style/FinalProfileIconButton"
            android:src="@drawable/bodeul_final_back"
            android:contentDescription="@string/guide_back" />
        <TextView
            style="@style/FinalHomeTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:text="@string/final_profile_settings" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="24dp"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <ProgressBar
                android:id="@+id/progressProfileSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />
            <include
                android:id="@+id/profileSettingsState"
                layout="@layout/include_state_panel" />
            <LinearLayout
                android:id="@+id/profileSettingsMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/buttonProfileSettingsSignOut"
        style="@style/BodeulFinalLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:background="@drawable/bg_final_profile_pill"
        android:text="@string/final_profile_sign_out"
        android:paddingStart="15dp"
        android:paddingEnd="15dp" />
</LinearLayout>