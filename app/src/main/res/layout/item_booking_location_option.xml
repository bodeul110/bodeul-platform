<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowBookingLocationOption"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="88dp" android:paddingTop="20dp" android:paddingBottom="20dp"
    android:gravity="center_vertical" android:descendantFocusability="blocksDescendants">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/textBookingLocationOptionTitle" style="@style/FinalBookingLabel"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/textBookingLocationOptionBody" style="@style/FinalBookingCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/final_text_secondary" />
    </LinearLayout>
    <ImageView android:id="@+id/checkBookingLocationOption"
        android:layout_width="20dp" android:layout_height="20dp"
        android:layout_marginStart="10dp" android:importantForAccessibility="no"
        android:src="@drawable/bodeul_final_booking_check" />
</LinearLayout>
