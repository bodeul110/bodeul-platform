<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/final_surface">
    <View
        android:layout_width="0dp"
        android:layout_height="375dp"
        android:background="@drawable/bg_final_home_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/layoutClientHomeTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp">
                <ImageView
                    android:id="@+id/imageHomeLogo"
                    android:layout_width="46dp"
                    android:layout_height="45.13dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6.87dp"
                    android:src="@drawable/bodeul_final_home_logo"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/textHomeMode"
                style="@style/FinalHomeCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:layout_marginHorizontal="12dp"
                android:gravity="end" />
            <FrameLayout
                android:id="@+id/buttonHomeSupport"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_final_home_bell"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/final_home_notifications">
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="noHideDescendants">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="-2dp"
                        android:src="@drawable/bodeul_final_home_bell_base"
                        android:contentDescription="@null" />
                    <ImageView
                        android:layout_width="10.25dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="9.8dp"
                        android:layout_marginTop="19.4dp"
                        android:src="@drawable/bodeul_final_home_bell_lower"
                        android:contentDescription="@null" />
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="16.75dp"
                        android:layout_marginStart="5.5dp"
                        android:layout_marginTop="4.4dp"
                        android:src="@drawable/bodeul_final_home_bell_upper"
                        android:contentDescription="@null" />
                </FrameLayout>
                <TextView
                    android:id="@+id/textHomeSupportHeaderBadge"
                    style="@style/FinalHomeCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:minWidth="18dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:background="@drawable/bg_final_auth_message"
                    android:backgroundTint="@color/final_text_error"
                    android:textColor="@color/final_surface"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollClientHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutClientHomeTopBar"
        app:layout_constraintBottom_toTopOf="@id/clientBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingBottom="30dp">
            <include
                android:id="@+id/homeStatePanel"
                layout="@layout/include_state_panel" />
            <LinearLayout
                android:id="@+id/homeContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="40dp"
                    android:paddingBottom="30dp"
                    android:paddingHorizontal="5dp"
                    android:orientation="horizontal"
                    android:gravity="top">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="12dp">
                        <TextView
                            android:id="@+id/textHomeGreeting"
                            style="@style/FinalHomeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/final_home_heading"
                            android:textSize="22sp"
                            app:lineHeight="28sp" />
                        <TextView
                            android:id="@+id/textHomeSubtitle"
                            style="@style/FinalHomeValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/final_home_tagline"
                            android:textColor="@color/final_text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="8dp">
                        <ImageView
                            android:id="@+id/imageHomeBanner"
                            android:layout_width="59.807dp"
                            android:layout_height="63.143dp"
                            android:layout_marginStart="4.31dp"
                            android:layout_marginTop="1.94dp"
                            android:src="@drawable/bodeul_final_home_banner"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>
                <include
                    android:id="@+id/layoutHomeSupportBanner"
                    layout="@layout/view_attention_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardActionBooking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/final_surface"
                    app:strokeColor="@color/final_brand_primary"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="15dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="15dp">
                        <TextView
                            style="@style/FinalHomeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/final_home_booking_title"
                            android:textColor="@color/final_text_secondary" />
                        <LinearLayout
                            android:id="@+id/buttonHomePickup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="24dp"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                style="@style/FinalHomeCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/final_home_location" />
                            <TextView
                                style="@style/FinalHomeValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/final_home_location_hint" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="19dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:id="@+id/buttonHomeDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:orientation="vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">
                                <TextView
                                    style="@style/FinalHomeCaption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/final_home_date" />
                                <TextView
                                    style="@style/FinalHomeValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/final_home_date_hint" />
                            </LinearLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="39dp"
                                android:layout_marginHorizontal="15dp"
                                android:background="@color/final_line" />
                            <LinearLayout
                                android:id="@+id/buttonHomeTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:orientation="vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">
                                <TextView
                                    style="@style/FinalHomeCaption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/final_home_time" />
                                <TextView
                                    style="@style/FinalHomeValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/final_home_time_hint" />
                            </LinearLayout>
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp">
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/buttonHomeHeroPrimary"
                                style="@style/BodeulFinalPrimaryButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="50dp"
                                android:paddingHorizontal="40dp"
                                android:textSize="16sp"
                                android:text="@string/final_home_booking_start" />
                            <FrameLayout
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="15dp"
                                android:background="@drawable/bg_final_home_arrow_circle"
                                android:importantForAccessibility="noHideDescendants">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:rotation="-90"
                                    android:src="@drawable/bodeul_final_home_button_arrow"
                                    android:contentDescription="@null" />
                            </FrameLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:id="@+id/layoutHomeProgressSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:padding="15dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/textHomeProgressBadge"
                        style="@style/FinalHomeCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/textHomeProgressTitle"
                        style="@style/FinalHomeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:id="@+id/textHomeProgressBody"
                        style="@style/FinalHomeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                    <LinearLayout
                        android:id="@+id/layoutHomeProgressStageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                    <TextView
                        android:id="@+id/buttonHomeProgressDetail"
                        style="@style/BodeulFinalLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/client_home_progress_detail_button" />
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/final_surface"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="20dp"
                        android:orientation="vertical">
                        <TextView
                            style="@style/FinalHomeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/final_home_book" />
                        <LinearLayout
                            android:id="@+id/layoutHomeNoticeContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp" />
                        <LinearLayout
                            android:id="@+id/textHomeNoticeMore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginTop="25dp"
                            android:background="@drawable/bg_final_home_more"
                            android:foreground="?attr/selectableItemBackground">
                            <TextView
                                style="@style/FinalHomeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:text="@string/final_home_more" />
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="5dp"
                                android:src="@drawable/bodeul_final_home_next"
                                android:rotation="180"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/cardActionSecondary"
                        style="@style/BodeulFinalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/final_home_health"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/cardActionSupport"
                        style="@style/BodeulFinalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/final_home_support"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/buttonHomeSignOut"
                        style="@style/BodeulFinalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/final_home_sign_out"
                        android:gravity="center" />
                </LinearLayout>
                <TextView
                    style="@style/FinalHomeCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/final_home_copyright" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ProgressBar
        android:id="@+id/progressHome"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutClientHomeTopBar"
        app:layout_constraintBottom_toTopOf="@id/clientBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <include
        android:id="@+id/clientBottomNavigation"
        layout="@layout/include_client_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
