<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="90dp" android:background="@drawable/bg_final_location_summary"
        android:gravity="center_vertical" android:padding="15dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/textBookingLocationTitle" style="@style/FinalBookingLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold" />
            <TextView android:id="@+id/textBookingLocationBody" style="@style/FinalBookingCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/final_text_secondary" />
        </LinearLayout>
        <TextView android:id="@+id/buttonBookingLocationDiagram" style="@style/BodeulFinalLink"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:background="@drawable/bg_final_hospital_map"
            android:text="@string/final_location_diagram" android:contentDescription="@string/final_location_diagram_open"
            android:textColor="@color/final_text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bookingLocationHeadingRow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:gravity="center_vertical">
        <TextView style="@style/FinalHospitalTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/final_location_heading" />
        <TextView android:id="@+id/buttonBookingLocationManual" style="@style/BodeulFinalLink"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:paddingEnd="0dp" android:text="@string/final_location_manual"
            android:textColor="@color/final_text_secondary" />
    </LinearLayout>
</LinearLayout>
