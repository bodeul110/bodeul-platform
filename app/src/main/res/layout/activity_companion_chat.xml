<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/companionChatRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/final_input_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/final_surface" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
                android:paddingStart="6dp" android:paddingEnd="15dp" android:gravity="center_vertical" android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonBackCompanionChat" style="@style/BodeulFinalChatIcon"
                    android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/bodeul_final_back"
                    android:contentDescription="@string/guide_back"/>
                <TextView android:id="@+id/textCompanionChatTitle" style="@style/BodeulFinalChatText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:maxWidth="188dp" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:fontFamily="@font/pretendard_bold" android:textSize="22sp" android:text="@string/companion_chat_title"/>
                <TextView android:id="@+id/textCompanionChatHeroBadge" style="@style/BodeulFinalChatText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:maxWidth="68dp" android:layout_marginStart="6dp" android:layout_marginEnd="10dp"
                    android:padding="4dp" android:textSize="10sp" android:background="@drawable/bg_final_chat_status" android:visibility="gone"/>
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView android:id="@+id/textCompanionChatAvatar" style="@style/BodeulFinalChatText" android:layout_width="34dp"
                    android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_final_chat_avatar"
                    android:textSize="12sp" android:importantForAccessibility="no" android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/companionChatActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:paddingStart="15dp" android:paddingEnd="6dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonCompanionChatProgress" style="@style/BodeulFinalChatAction"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/final_chat_progress"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonCompanionChatDetails" style="@style/BodeulFinalChatAction"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="@string/final_chat_details"/>
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonCompanionChatMore" style="@style/BodeulFinalChatIcon"
                    android:layout_width="48dp" android:layout_height="48dp" android:padding="9dp" android:background="@drawable/bg_final_chat_action" android:src="@drawable/bodeul_final_chat_more"
                    android:contentDescription="@string/final_chat_more"/>
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/scrollCompanionChatState" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="true" android:padding="15dp">
            <include android:id="@+id/companionChatStatePanel" layout="@layout/include_state_panel"/>
        </ScrollView>
        <LinearLayout android:id="@+id/companionChatContentContainer" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
            <ScrollView android:id="@+id/scrollCompanionChat" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="20dp" android:paddingBottom="20dp">
                    <TextView android:id="@+id/textCompanionChatEmptyBody" style="@style/BodeulFinalChatText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/final_text_secondary"/>
                    <LinearLayout android:id="@+id/layoutCompanionChatMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
            </ScrollView>
            <LinearLayout android:id="@+id/companionChatComposer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="10dp" android:paddingBottom="14dp" android:orientation="vertical">
                <ScrollView android:id="@+id/layoutCompanionChatPendingAttachment" android:layout_width="match_parent" android:layout_height="96dp" android:visibility="gone">
                    <LinearLayout android:id="@+id/layoutCompanionChatPendingAttachmentItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </ScrollView>
                <TextView android:id="@+id/textCompanionChatClosed" style="@style/BodeulFinalChatText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/final_chat_closed" android:textColor="@color/final_text_secondary" android:visibility="gone"/>
                <LinearLayout android:id="@+id/layoutCompanionChatInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_final_chat_pill" android:gravity="center_vertical" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonCompanionChatAttach" style="@style/BodeulFinalChatIcon"
                        android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/bodeul_final_chat_camera"
                        android:contentDescription="@string/companion_chat_attach"/>
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/inputCompanionChatMessage" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:minHeight="48dp" android:minLines="1" android:maxLines="3" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:paddingStart="0dp" android:paddingEnd="0dp" android:background="@null" android:fontFamily="@font/pretendard_medium" android:textSize="13sp"
                        android:textColor="@color/final_text_primary" android:textColorHint="@color/final_text_hint" android:hint="@string/final_chat_hint"
                        android:inputType="textMultiLine|textCapSentences" android:importantForAutofill="no" android:gravity="center_vertical"/>
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonCompanionChatSend" style="@style/BodeulFinalChatIcon"
                        android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/bodeul_final_chat_send" android:contentDescription="@string/companion_chat_send"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/progressCompanionChat" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center"/>
</FrameLayout>
