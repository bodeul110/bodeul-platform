<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookingPaymentRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
        android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="15dp">
        <ImageButton android:id="@+id/buttonBackBookingPayment" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp"
            android:src="@drawable/bodeul_final_back" android:contentDescription="@string/guide_back" />
        <TextView android:id="@+id/textBookingPaymentHeader" style="@style/FinalBookingTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="22sp" android:text="@string/final_booking_payment_header" />
    </LinearLayout>
    <ScrollView android:id="@+id/scrollBookingPayment" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:id="@+id/bookingPaymentContent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingTop="10dp" android:paddingBottom="20dp">
            <TextView android:id="@+id/textBookingPaymentBadge" style="@style/FinalBookingCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/final_text_accent_accessible" />
            <TextView android:id="@+id/textBookingPaymentTitle" style="@style/FinalBookingTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/textBookingPaymentBody" style="@style/FinalBookingReviewLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="20dp" android:paddingHorizontal="15dp" android:paddingBottom="20dp"
                android:background="@drawable/bg_final_booking_hospital_summary">
                <TextView style="@style/FinalBookingReviewLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/booking_payment_method_section" />
                <TextView android:id="@+id/textBookingPaymentMethod" style="@style/FinalBookingBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <TextView style="@style/FinalBookingReviewLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/booking_coupon_section" />
                <TextView android:id="@+id/textBookingPaymentCoupon" style="@style/FinalBookingBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <TextView style="@style/FinalBookingReviewLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/final_booking_completion_price_label" />
                <TextView android:id="@+id/textBookingPaymentAmount" style="@style/FinalBookingBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            </LinearLayout>
            <TextView android:id="@+id/textBookingPaymentSummaryTitle" style="@style/FinalBookingLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="25dp" android:text="@string/final_booking_completion_summary" />
                <TextView style="@style/FinalBookingReviewLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/booking_status_line_schedule" />
                <TextView android:id="@+id/textBookingPaymentSchedule" style="@style/FinalBookingBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <TextView style="@style/FinalBookingReviewLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/booking_status_line_hospital" />
                <TextView android:id="@+id/textBookingPaymentHospital" style="@style/FinalBookingBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <TextView style="@style/FinalBookingReviewLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/booking_status_line_place" />
                <TextView android:id="@+id/textBookingPaymentMeetingPlace" style="@style/FinalBookingBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="@color/final_line" />
            <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/checkBookingPaymentConsent"
                style="@style/FinalBookingPaymentConsent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:minHeight="48dp" android:paddingVertical="12dp" android:paddingStart="8dp" android:paddingEnd="0dp"
                app:buttonTint="@color/final_text_accent_accessible" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/bookingPaymentBottomAction" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="15dp" android:paddingTop="10dp" android:paddingBottom="15dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonBookingPaymentApprove"
            style="@style/BodeulFinalPrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>
