<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/layoutBookingTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:paddingStart="6dp"
            android:paddingEnd="15dp">
            <ImageButton
                android:id="@+id/buttonBackBooking"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:padding="9dp"
                android:src="@drawable/bodeul_final_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/guide_back" />
            <TextView
                android:id="@+id/buttonCloseBooking"
                style="@style/BodeulFinalLink"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/buttonBackBooking"
                android:layout_centerVertical="true"
                android:gravity="end|center_vertical"
                android:text="@string/final_booking_history"
                android:textColor="@color/final_text_secondary" />
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/bookingStepProgress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="horizontal">
            <ProgressBar
                android:id="@+id/bookingProgressParticipant"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:max="100"
                android:progressTint="@color/final_brand_primary"
                android:progressBackgroundTint="@color/final_line" />
            <ProgressBar
                android:id="@+id/bookingProgressVisit"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:max="100"
                android:progressTint="@color/final_brand_primary"
                android:progressBackgroundTint="@color/final_line" />
            <ProgressBar
                android:id="@+id/bookingProgressHealth"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:max="100"
                android:progressTint="@color/final_brand_primary"
                android:progressBackgroundTint="@color/final_line" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollBooking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true">
            <TextView
                android:id="@+id/textBookingMode"
                style="@style/FinalBookingCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <include
                android:id="@+id/bookingStatePanel"
                layout="@layout/include_state_panel" />
            <LinearLayout
                android:id="@+id/bookingContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/textBookingStepTitle"
                    style="@style/FinalBookingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/final_booking_who" />
                <LinearLayout
                    android:id="@+id/bookingStepParticipant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">
                    <include
                        layout="@layout/include_final_booking_participant" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bookingStepVisit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <include
                        layout="@layout/include_final_booking_visit" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bookingStepHealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <include
                        layout="@layout/include_final_booking_health" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bookingStepPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <include
                        layout="@layout/include_final_booking_payment" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bookingHistoryPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/textBookingRequesterName"
                        style="@style/FinalBookingBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/textBookingRequesterRole"
                        style="@style/FinalBookingCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/textBookingRequesterPhone"
                        style="@style/FinalBookingCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBookingLatest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/final_input_surface">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="15dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/textBookingLatestStatus"
                                style="@style/FinalBookingCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:id="@+id/textBookingLatestTitle"
                                style="@style/FinalBookingLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp" />
                            <TextView
                                android:id="@+id/textBookingLatestBody"
                                style="@style/FinalBookingCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:id="@+id/bookingRequestsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/textBookingFormTitle"
                        style="@style/FinalBookingCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/textBookingFormBadge"
                        style="@style/FinalBookingCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/textBookingFormHelper"
                        style="@style/FinalBookingCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ProgressBar
        android:id="@+id/progressBooking"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/final_brand_primary"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/bookingFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingNext"
            style="@style/FinalBookingButton"
            android:layout_width="88dp"
            android:layout_gravity="end"
            android:minHeight="50dp"
            android:text="@string/final_booking_next" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSubmitBooking"
            style="@style/FinalBookingButton"
            android:text="@string/final_booking_submit"
            android:visibility="gone" />
    </FrameLayout>
    <include
        layout="@layout/include_client_bottom_navigation"
        android:visibility="gone" />
</LinearLayout>