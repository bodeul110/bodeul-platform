<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="Theme.Bodeul.FinalBooking"
        parent="Theme.Bodeul.FinalAuth" />
    <color
        name="final_booking_selected">#E7F5FF</color>
    <style
        name="FinalBookingTitle"
        parent="FinalHomeTitle">
        <item
            name="android:minHeight">26sp</item>
    </style>
    <style
        name="FinalBookingLabel"
        parent="FinalHomeTitle">
        <item
            name="android:textSize">15sp</item>
        <item
            name="android:fontFamily">@font/pretendard_semibold</item>
        <item
            name="lineHeight">22sp</item>
        <item
            name="android:minHeight">22sp</item>
    </style>
    <style
        name="FinalBookingBody"
        parent="FinalHomeTitle">
        <item
            name="android:textSize">16sp</item>
        <item
            name="android:fontFamily">@font/pretendard_medium</item>
        <item
            name="lineHeight">22sp</item>
        <item
            name="android:minHeight">22sp</item>
    </style>
    <style
        name="FinalBookingCaption"
        parent="FinalHomeCaption">
        <item
            name="android:textSize">13sp</item>
        <item
            name="lineHeight">18sp</item>
        <item
            name="android:minHeight">18sp</item>
    </style>
    <style
        name="FinalBookingInput"
        parent="BodeulFinalInput">
        <item
            name="android:minHeight">56dp</item>
        <item
            name="android:textSize">16sp</item>
        <item
            name="lineHeight">22sp</item>
    </style>
    <style
        name="FinalBookingTextArea"
        parent="FinalBookingInput">
        <item
            name="android:singleLine">false</item>
        <item
            name="android:minHeight">135dp</item>
        <item
            name="android:gravity">top|start</item>
        <item
            name="android:inputType">textMultiLine|textCapSentences</item>
        <item
            name="android:textSize">15sp</item>
        <item
            name="android:paddingTop">15dp</item>
        <item
            name="android:paddingBottom">15dp</item>
    </style>
    <style
        name="FinalBookingButton"
        parent="Widget.MaterialComponents.Button">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:minHeight">56dp</item>
        <item
            name="android:minWidth">0dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="android:paddingStart">15dp</item>
        <item
            name="android:paddingEnd">15dp</item>
        <item
            name="android:paddingTop">12dp</item>
        <item
            name="android:paddingBottom">12dp</item>
        <item
            name="android:fontFamily">@font/pretendard_bold</item>
        <item
            name="android:textSize">15sp</item>
        <item
            name="android:letterSpacing">0</item>
        <item
            name="android:includeFontPadding">false</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="android:textColor">@color/final_text_on_primary</item>
        <item
            name="android:stateListAnimator">@null</item>
        <item
            name="cornerRadius">10dp</item>
        <item
            name="strokeWidth">0dp</item>
        <item
            name="backgroundTint">@color/final_brand_primary</item>
        <item
            name="rippleColor">@color/final_ripple</item>
    </style>
    <style
        name="FinalBookingChoice"
        parent="FinalBookingButton">
        <item
            name="backgroundTint">@color/final_input_surface</item>
        <item
            name="android:textColor">@color/final_text_primary</item>
        <item
            name="android:fontFamily">@font/pretendard_medium</item>
        <item
            name="android:textSize">16sp</item>
    </style>
    <style
        name="FinalBookingSelector"
        parent="FinalBookingChoice">
        <item
            name="android:gravity">start|center_vertical</item>
        <item
            name="icon">@drawable/bodeul_final_booking_dropdown_down</item>
        <item
            name="iconTint">@null</item>
        <item
            name="iconSize">14dp</item>
        <item
            name="iconGravity">end</item>
        <item
            name="cornerRadius">12dp</item>
    </style>
</resources>