<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bodeul.FinalChat" parent="Theme.Bodeul.FinalAuth">
        <item name="android:windowBackground">@color/final_input_surface</item>
        <item name="android:navigationBarColor">@color/final_input_surface</item>
    </style>
    <style name="BodeulFinalChatText" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textColor">@color/final_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="BodeulFinalChatIcon" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="BodeulFinalChatAction" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_final_chat_action</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.BodeulFinal.Caption</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/final_text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
