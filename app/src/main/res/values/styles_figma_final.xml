<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bodeul.FinalAuth" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/final_brand_primary</item>
        <item name="colorSecondary">@color/final_brand_primary</item>
        <item name="colorError">@color/final_error</item>
        <item name="android:windowBackground">@color/final_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/final_text_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Bodeul.FinalAuthDialog</item>
    </style>
    <style name="ThemeOverlay.Bodeul.FinalAuthDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/BodeulFinalDialogTextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BodeulFinalDialogTextButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/BodeulFinalDialogTextButton</item>
    </style>
    <style name="TextAppearance.BodeulFinal.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">@dimen/final_body_size</item>
        <item name="lineHeight">@dimen/final_body_line_height</item>
        <item name="android:textColor">@color/final_text_primary</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.BodeulFinal.Caption" parent="TextAppearance.BodeulFinal.Body">
        <item name="android:textSize">@dimen/final_caption_size</item>
        <item name="lineHeight">@dimen/final_caption_line_height</item>
    </style>
    <style name="TextAppearance.BodeulFinal.Button" parent="TextAppearance.BodeulFinal.Body">
        <item name="fontFamily">@font/pretendard_bold</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/final_button_size</item>
        <item name="lineHeight">@dimen/final_button_line_height</item>
        <item name="android:textColor">@color/final_text_on_primary</item>
    </style>
    <style name="BodeulFinalInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/final_input_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/final_corner_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/final_corner_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/final_corner_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/final_corner_control</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="errorTextColor">@color/final_text_error</item>
        <item name="errorTextAppearance">@style/TextAppearance.BodeulFinal.Caption</item>
        <item name="errorIconDrawable">@null</item>
    </style>
    <style name="BodeulFinalInput" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">@dimen/final_body_line_height</item>
        <item name="android:textAppearance">@style/TextAppearance.BodeulFinal.Body</item>
        <item name="android:textColor">@color/final_text_primary</item>
        <item name="android:textColorHint">@color/final_text_hint</item>
        <item name="android:minHeight">@dimen/final_input_height</item>
        <item name="android:paddingStart">@dimen/final_screen_gutter</item>
        <item name="android:paddingEnd">@dimen/final_screen_gutter</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@null</item>
    </style>
    <style name="BodeulFinalPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/pretendard_bold</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">@dimen/final_button_line_height</item>
        <item name="android:textAppearance">@style/TextAppearance.BodeulFinal.Button</item>
        <item name="android:minHeight">@dimen/final_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/final_screen_gutter</item>
        <item name="android:paddingEnd">@dimen/final_screen_gutter</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_final_primary_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="BodeulFinalLink" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">@dimen/final_caption_line_height</item>
        <item name="android:textAppearance">@style/TextAppearance.BodeulFinal.Caption</item>
        <item name="android:minHeight">@dimen/final_touch_target</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="BodeulFinalDialogTextButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/final_text_primary</item>
    </style>
</resources>
