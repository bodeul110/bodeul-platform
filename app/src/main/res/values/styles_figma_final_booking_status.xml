<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FinalBookingStatusSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>
    <style name="FinalBookingStatusLines" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:background">@drawable/bg_final_booking_summary</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="FinalBookingStatusAccordion" parent="FinalBookingChoice">
        <item name="android:minHeight">50dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="icon">@drawable/bodeul_final_booking_dropdown_down</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">14dp</item>
        <item name="iconTint">@null</item>
    </style>
</resources>
