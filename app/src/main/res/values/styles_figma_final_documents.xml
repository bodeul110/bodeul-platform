<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FinalDocumentSheetTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FinalDocumentSheet</item>
    </style>
    <style name="FinalDocumentSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/final_surface</item>
        <item name="shapeAppearanceOverlay">@style/FinalDocumentSheetShape</item>
    </style>
    <style name="FinalDocumentSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="FinalDocumentTitle" parent="FinalHomeTitle">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">26sp</item>
    </style>
    <style name="FinalDocumentCaption" parent="FinalHomeCaption">
        <item name="android:textColor">@color/final_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
    </style>
    <style name="FinalDocumentButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/final_documents_button_text</item>
        <item name="backgroundTint">@color/final_documents_button_background</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="FinalDocumentFileButton" parent="FinalDocumentButton">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">100dp</item>
        <item name="android:textColor">@color/final_text_secondary</item>
        <item name="backgroundTint">@color/final_input_surface</item>
    </style>
</resources>
