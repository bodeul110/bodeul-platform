<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FinalReportText" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.BodeulFinal.Body</item>
        <item name="android:textColor">@color/final_text_primary</item>
    </style>
    <style name="FinalReportHeading" parent="FinalReportText">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">26sp</item>
    </style>
    <style name="FinalReportLabel" parent="FinalReportText">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/final_text_secondary</item>
    </style>
    <style name="FinalReportCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">15dp</item>
        <item name="android:layout_marginEnd">15dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="cardBackgroundColor">@color/final_surface</item>
        <item name="cardCornerRadius">15dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/final_line</item>
    </style>
</resources>
