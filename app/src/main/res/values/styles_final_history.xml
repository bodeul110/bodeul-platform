<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FinalHistoryFilterTab" parent="Widget.AppCompat.TextView">
        <item name="android:background">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/final_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FinalHistoryHospitalImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="FinalHistorySecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/final_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/final_surface</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/final_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="FinalHistoryPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/final_text_on_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/final_brand_primary</item>
        <item name="cornerRadius">10dp</item>
    </style>
</resources>
