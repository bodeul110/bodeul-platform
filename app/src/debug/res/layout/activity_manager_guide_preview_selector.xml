<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/managerGuidePreviewSelectorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_mvp_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:text="@string/debug_manager_guide_preview_title"
        android:textColor="@color/figma_mvp_text_primary"
        android:textSize="24sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/debug_manager_guide_preview_body"
        android:textColor="@color/figma_mvp_text_secondary"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/listManagerGuidePreviewSteps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/figma_mvp_surface"
        android:clipToPadding="false"
        android:divider="@color/figma_mvp_divider"
        android:dividerHeight="1dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

</LinearLayout>
